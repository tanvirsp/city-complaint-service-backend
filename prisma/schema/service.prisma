model Service {
    id             String           @id @default(uuid())
    name           String           @db.VarChar(255)
    description    String?
    serviceFee     Decimal          @db.Decimal(10, 2)
    createdAt      DateTime         @default(now())
    updatedAt      DateTime         @updatedAt
    serviceRequest ServiceRequest[]

    @@map("services")
}
